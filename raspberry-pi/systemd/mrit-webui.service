[Unit]
Description=MRIT Web UI
After=multi-user.target

[Service]
Type=simple
User=mrit
WorkingDirectory=/home/mrit/mrit-server
ExecStart=/home/mrit/mrit-server/venv/bin/python web_ui.py
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mrit-webui

[Install]
WantedBy=multi-user.target
